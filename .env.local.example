# Turso (libSQL) — CLAUDE.md 1장, 4장
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Claude API — 후보 큐레이션·해설 생성 전용 (CLAUDE.md 2.2, 2.3)
ANTHROPIC_API_KEY=

# 정식 출시 전 프리미엄 작명(/naming, /api/name) 접근 제한 — 쉼표로 구분한 이메일 목록. 여기 등록된
# 이메일로 로그인한 계정만 관리자로 취급되어 위저드에 접근할 수 있다 (lib/auth.ts isAdminUser).
ADMIN_EMAILS=

# SNS 로그인(카카오/네이버) — next-auth(Auth.js v5, lib/oauth.ts). AUTH_SECRET은
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`로 생성한 무작위 값을
# 넣는다(JWT 서명/암호화 키, 노출되면 안 됨). 나머지는 각 제공자 개발자 콘솔에서 발급받는다.
# 콜백(리다이렉트) URI는 반드시 아래 형식으로 등록해야 한다:
#   개발:   http://localhost:3000/api/auth/callback/{kakao|naver}
#   프로덕션: https://{배포 도메인}/api/auth/callback/{kakao|naver}
AUTH_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 결제(페이앱, CLAUDE.md 0.4) — 프리미엄 작명 유료화. PAYMENT_PROVIDER만 바꾸면 추후 다른 PG사
# (예: 토스페이먼츠) 구현으로 교체할 수 있도록 lib/payment/에 격리했다(현재는 payapp만 구현).
PAYMENT_PROVIDER=payapp
# 페이앱 판매자 관리사이트 "설정 > 연동정보"에서 확인.
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
PAYAPP_SHOPNAME=유어네임
# feedbackurl(결제 웹훅)·returnurl(모바일 결제 완료 후 복귀) 절대 URL 생성에 쓴다. 미설정 시
# VERCEL_URL(배포 환경 자동 제공)로 폴백하고, 그마저 없으면 localhost:3000으로 폴백한다 — 로컬
# 개발 중에는 페이앱이 로컬호스트로 웹훅을 보낼 수 없으므로, 실제 결제 테스트에는 ngrok 등 외부
# 접근 가능한 URL을 이 값에 넣어야 한다.
APP_BASE_URL=
